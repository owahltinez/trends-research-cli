# Copy to .env and fill in. Never commit .env.
#
# This API is allow-listed per Google Cloud project: a key cannot simply be
# created in the console, it has to be requested at
#     https://support.google.com/trends/contact/trends_api
#
# Once you have one, `gtrends doctor` will tell you whether it works and
# whether the project is allow-listed -- the API reports those two failures
# identically.
TRENDS_API_KEY=
